# Todas as variáveis são opcionais em desenvolvimento: sem elas o site usa
# fallbacks seguros (rate limit em memória, e-mail apenas simulado, sem captcha).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub (opcional — aumenta o limite da API de 60 para 5000 req/h)
GITHUB_TOKEN=

# Resend — envio do formulário de contato
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — rate limit distribuído
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
